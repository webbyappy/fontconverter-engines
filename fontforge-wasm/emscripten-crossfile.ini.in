# Meson cross file for GLib under Emscripten 6.0.2: the house file (libmirage-wasm/emscripten-crossfile.ini) plus the
# house exception flag, the prefix maps that keep local paths out of the binary, and a pkg-config path confined to
# the build's own wasm libraries. build-deps.sh renders @C_ARGS@ and @PKG_CONFIG_LIBDIR@ into build/.
[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
strip = 'emstrip'
ranlib = 'emranlib'
pkg-config = 'pkg-config'

[built-in options]
c_args = [@C_ARGS@]
c_link_args = ['-fexceptions']

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[properties]
pkg_config_libdir = [@PKG_CONFIG_LIBDIR@]
sizeof_char = 1
sizeof_short = 2
sizeof_int = 4
sizeof_long = 4
sizeof_long_long = 8
sizeof_size_t = 4
alignment_char = 1
alignment_short = 2
alignment_int = 4
alignment_long = 4
alignment_double = 8
has_function_printf = true
has_function_hfkerhisdf = false
growing_stack = false
